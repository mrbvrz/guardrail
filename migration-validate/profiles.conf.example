# profiles.conf - server profiles for migration-validate.sh
#
# Format (one line per server):
#   name|host|source_path|dest_path|folder1,folder2,...
#
# - name         : label, used with --server <name>
# - host         : user@ip  (SSH key for root must be installed)
# - source_path  : webroot path on source server
# - dest_path    : webroot path on destination server
# - folder       : comma-separated folders. If destination folder name
#                  differs from source, write src=dst
#
# Lines starting with # are ignored. Spaces around | are trimmed.

# --- Example profiles (replace with your servers) ---
# srv1|user@10.0.0.1|/var/www/html|/var/www/html|app1,app2,app3
# srv2|user@10.0.0.2|/home/user/public_html|/var/www/html|public_html=web
# srv3|user@10.0.0.3|/opt/app|/opt/app|data,logs,config

# --- Active profiles (host addresses are kept out of version control) ---
srv1|root@REPLACE-IP|/home/simpel/public_html|/var/www/html|simpel3,mobile,simpel2,simpel3_api,surat
srv2|root@REPLACE-IP|/home/perizinan|/var/www/html|public_html=perizinan
srv3|root@REPLACE-IP|/home/simpel/public_html|/var/www/html|web
srv4|root@REPLACE-IP|/home/simpel/public_html|/var/www/html|mpp